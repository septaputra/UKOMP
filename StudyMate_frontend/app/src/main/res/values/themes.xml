<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StudyMate" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.StudyMate.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/studymate_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/studymate_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.StudyMate</item>
        <item name="android:windowBackground">@drawable/studymate_splash_window</item>
        <item name="android:statusBarColor">@color/studymate_splash_background</item>
        <item name="android:navigationBarColor">@color/studymate_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
